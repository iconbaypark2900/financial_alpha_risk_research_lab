{
    "services": {
        "market_data_pipeline": {
            "enabled": true,
            "schedule": "0 0 * * *",
            "data_sources": ["alpaca", "fred", "sec_edgar", "ccxt"]
        },
        "factor_update_pipeline": {
            "enabled": true,
            "schedule": "0 2 * * *",
            "factor_library": ["momentum", "volatility", "value", "quality"]
        },
        "backtest_pipeline": {
            "enabled": true,
            "max_concurrent_backtests": 10,
            "data_lookback_period": "5y"
        },
        "strategy_evolution_pipeline": {
            "enabled": true,
            "optimization_method": "optuna",
            "population_size": 50,
            "generations": 100
        },
        "research_rag_pipeline": {
            "enabled": true,
            "indexing_frequency": "daily",
            "document_sources": ["filings", "transcripts", "research_reports"]
        },
        "portfolio_risk_service": {
            "enabled": true,
            "risk_metrics": ["var", "cvar", "max_drawdown"],
            "stress_scenarios": ["rates_shock", "credit_spread_widening", "volatility_spike"]
        }
    },
    "database": {
        "opensearch": {
            "host": "localhost",
            "port": 9200
        },
        "qdrant": {
            "host": "localhost",
            "port": 6333
        },
        "neo4j": {
            "host": "localhost",
            "port": 7687,
            "username": "neo4j",
            "password": "password"
        }
    },
    "secrets": {
        "vault_url": "http://localhost:8200"
    },
    "observability": {
        "mlflow_tracking_uri": "http://localhost:5000",
        "langfuse_secret_key": "",
        "langfuse_public_key": "",
        "prometheus_endpoint": "http://localhost:9090"
    }
}